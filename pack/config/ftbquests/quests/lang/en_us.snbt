{
	"chapter.09F59AA5059D8507.chapter_subtitle": ["Cobblemon. Optional - skip this chapter if you don't want Pokémon."]
	"chapter.09F59AA5059D8507.title": "Pokémon"
	"chapter.22342087C3E31DF2.chapter_subtitle": ["Machines, trains and airships. Hold W over any Create item for a tutorial."]
	"chapter.22342087C3E31DF2.title": "Create and Flight"
	"chapter.2B373BC1863F4EDD.chapter_subtitle": ["Combat classes, skill trees and Iron's spellcasting."]
	"chapter.2B373BC1863F4EDD.title": "Classes and Magic"
	"chapter.459194B83D1E22FC.chapter_subtitle": ["Apotheosis loot, enchanting and world-tier gateways."]
	"chapter.459194B83D1E22FC.title": "Gear and World Tiers"
	"chapter.6B7E0F6325F16188.chapter_subtitle": ["Every dimension in the pack, in any order."]
	"chapter.6B7E0F6325F16188.title": "Dimensions"
	"chapter.793E32936A23A83E.chapter_subtitle": ["Start here. Every chapter is optional."]
	"chapter.793E32936A23A83E.title": "Welcome to Bankopack"
	"chapter.7A25D1A2C851F11B.chapter_subtitle": ["Major boss fights."]
	"chapter.7A25D1A2C851F11B.title": "Bosses"
	"quest.000A2AE661E58801.quest_desc": ["In the &bBurning Arena&r in the Nether."]
	"quest.000A2AE661E58801.title": "Ignis"
	"quest.04799DA6BA192B54.quest_desc": ["In the &bRuined Citadel&r in the End."]
	"quest.04799DA6BA192B54.title": "Ender Guardian"
	"quest.05F16A6C0EDEA9AC.quest_desc": ["Stores the Pokémon that aren't in your party."]
	"quest.05F16A6C0EDEA9AC.title": "PC"
	"quest.063018811F3FBDD0.quest_desc": ["At the &bAcropolis&r in warm ocean."]
	"quest.063018811F3FBDD0.title": "Scylla"
	"quest.07E13B289262AE88.quest_desc": ["Iron's Spells 'n Spellbooks is a separate magic system with its own mana.", "Inscribe scrolls into a spell book at the Inscription Table."]
	"quest.07E13B289262AE88.title": "Inscription Table"
	"quest.09B7476C05882565.quest_desc": ["Extra storage plus two fluid tanks. Worn in the back slot; press its keybind to open it."]
	"quest.09B7476C05882565.title": "Traveler's Backpack"
	"quest.0A3EECDFE0AD3358.quest_desc": ["The first Twilight Forest boss, in the Naga Courtyard."]
	"quest.0A3EECDFE0AD3358.title": "The Naga"
	"quest.0ECA2495A33D279B.quest_desc": ["A dimension with its own bosses and gear. Check JEI for how to get there."]
	"quest.0ECA2495A33D279B.title": "Eternal Starlight"
	"quest.11AA5BE99AC39090.quest_desc": ["In the &bCursed Pyramid&r in the desert."]
	"quest.11AA5BE99AC39090.title": "Ancient Remnant"
	"quest.1270154D4EC22EB4.quest_desc": ["Apotheosis changes enchanting: each shelf type adds different amounts of power, quanta (randomness)", "and arcana (rarity). The enchanting table shows the totals."]
	"quest.1270154D4EC22EB4.title": "Hellshelf"
	"quest.12DC313135AB267D.quest_desc": ["Points you to any biome you choose."]
	"quest.12DC313135AB267D.title": "Nature's Compass"
	"quest.1734DF801400FB2B.quest_desc": ["Create Aeronautics turns builds into physics objects. Glue your build with Super Glue,", "then use a Physics Assembler on it. Hold W over any Aeronautics block to see how it works."]
	"quest.1734DF801400FB2B.title": "Physics Assembler"
	"quest.175E83D24BDA93D6.quest_desc": ["Classes: &bWizard&r (arcane, fire, frost), &bPaladin&r, &bPriest&r, &bRogue&r, &bWarrior&r, &bArcher&r,", "&bBerserker&r, &bForcemaster&r, &bWitcher&r, &bElemental Wizard&r and &bBard&r.", "Equip the spell book and hold a weapon to cast. Type &a@rpg&r in JEI to see all class items."]
	"quest.175E83D24BDA93D6.title": "Choose a Class"
	"quest.18C258442607B6D0.quest_desc": ["Enemies spawn with their own affix gear."]
	"quest.18C258442607B6D0.title": "World Tier: Summit"
	"quest.19967447C616E9DF.quest_desc": ["Rare loot is gated by &bWorld Tier&r. Each tier has a Gateway: craft its Gate Pearl (see JEI),", "throw it, and survive the waves. Clearing it unlocks the next tier."]
	"quest.19967447C616E9DF.title": "World Tier: Frontier"
	"quest.1C382C25CEC3FB4D.quest_desc": ["Summoned with soul sand and three wither skeleton skulls."]
	"quest.1C382C25CEC3FB4D.title": "The Wither"
	"quest.1C6FF91D4AC58B74.quest_desc": ["A boiler (fluid tanks heated by a blaze burner) with steam engines on it gives a lot of power."]
	"quest.1C6FF91D4AC58B74.title": "Steam Engine"
	"quest.1E2B5F9E55B20CBA.quest_desc": ["Farmer's Delight meals restore more hunger and give effects.", "Cooking pots need a fire or campfire underneath. Check JEI for recipes."]
	"quest.1E2B5F9E55B20CBA.title": "Cooking Pot"
	"quest.1E8266AD03A9E04C.quest_desc": ["Classes are built around &bspell books&r. Craft a Spell Binding Table (surround it with bookshelves)", "to make your class's spell book and unlock its spells."]
	"quest.1E8266AD03A9E04C.title": "Spell Binding Table"
	"quest.1E8373E306AA468E.quest_desc": ["Looted gear can have &baffixes&r with rarities. The Reforging Table rerolls them."]
	"quest.1E8373E306AA468E.title": "Reforging Table"
	"quest.1EB9BAC21AEF8120.quest_desc": ["Wizard spells use &brunes&r as ammunition, like arrows for a bow."]
	"quest.1EB9BAC21AEF8120.title": "Rune Crafting"
	"quest.201678BED4BE4291.quest_desc": ["True Ending gives the dragon new attacks and phases. Destroy the crystals first."]
	"quest.201678BED4BE4291.title": "The Ender Dragon"
	"quest.204036FD959CDCBD.quest_desc": ["The final tier. After this, the Endless Invader gateway is the hardest challenge."]
	"quest.204036FD959CDCBD.title": "World Tier: Pinnacle"
	"quest.2262FC42EA064B78.quest_desc": ["Ready-made planes and airships, separate from Create."]
	"quest.2262FC42EA064B78.title": "Immersive Aircraft"
	"quest.2591340770B744DF.quest_desc": ["Tracks the Pokémon you've seen and caught. Any colour counts."]
	"quest.2591340770B744DF.title": "Pokédex"
	"quest.291B3C2852C4501F.quest_desc": ["Mega Showdown adds Mega Evolution, Z-Moves, Terastallization and Dynamax.", "Wear a Mega Bracelet in its &baccessory&r slot and give a compatible Pokémon its Mega Stone.", "In battle, after picking Fight, toggle the Mega button next to Back, then choose a move."]
	"quest.291B3C2852C4501F.title": "Mega Evolution"
	"quest.29862A55BB3452C8.quest_desc": ["Steering wheels and throttle levers control your ship."]
	"quest.29862A55BB3452C8.title": "Steering Wheel"
	"quest.2B158A7B089C67C8.quest_desc": ["Upgrades or rerolls individual affixes. Gems are socketed at a smithing table."]
	"quest.2B158A7B089C67C8.title": "Augmenting Table"
	"quest.2D22D6E97454D1FD.quest_desc": ["Lets your Pokémon roam freely near your base."]
	"quest.2D22D6E97454D1FD.title": "Pasture"
	"quest.2ED0F097C46C0806.quest_desc": ["Seasons are on. Some crops only grow in certain seasons.", "A calendar shows the current season and how long it lasts."]
	"quest.2ED0F097C46C0806.title": "Seasons"
	"quest.312549E37E66FDF5.quest_desc": ["Most early Create machines are made from andesite alloy."]
	"quest.312549E37E66FDF5.title": "Andesite Alloy"
	"quest.320CB8AC46236416.quest_desc": ["A Propeller Bearing with sails (or a ready-made propeller) driven by a Portable Engine moves your ship.", "Use a wrench on the bearing to reverse thrust."]
	"quest.320CB8AC46236416.title": "Propellers"
	"quest.3613530C9B497875.quest_desc": ["Fully heals your party. It recharges over time."]
	"quest.3613530C9B497875.title": "Healing Machine"
	"quest.37B1862372B0D6BB.quest_desc": ["Make a small pool of water surrounded by flowers or grass and throw a &bdiamond&r into it.", "Its bosses are meant to be fought in order."]
	"quest.37B1862372B0D6BB.title": "The Twilight Forest"
	"quest.38965F181FD84DB4.quest_desc": ["Press your &bPokémon summary&r key (see Controls) to pick a starter Pokémon.", "To catch wild Pokémon, weaken them in battle, then throw a Poké Ball."]
	"quest.38965F181FD84DB4.title": "Choose a Starter"
	"quest.3FD1E196C8480A68.quest_desc": ["Turns flowing water into rotation. Connect machines with shafts and cogwheels."]
	"quest.3FD1E196C8480A68.title": "Water Wheel"
	"quest.402610FF839A08A4.quest_desc": ["True Ending overhauls the dragon fight. The outer islands have new biomes."]
	"quest.402610FF839A08A4.title": "The End"
	"quest.41B89DC3CE373DEA.quest_desc": ["Makes plates, and with a basin underneath it compacts items."]
	"quest.41B89DC3CE373DEA.title": "Mechanical Press"
	"quest.4411A3CD46F10A44.quest_desc": ["Hot Air Burners fill an enclosed balloon of Envelope blocks with hot air to give lift.", "Power the burner with redstone (a lever works)."]
	"quest.4411A3CD46F10A44.title": "Hot Air Balloon"
	"quest.47D6FDCEF55CA283.quest_desc": ["Deeper and Darker's dimension. The portal is in an &bAncient City&r; check JEI for how to activate it."]
	"quest.47D6FDCEF55CA283.title": "The Otherside"
	"quest.49814E8944EDFB47.quest_desc": ["This book covers the pack's main systems: classes and spells, Create airships, Pokémon,", "dimensions and bosses. None of it is required.", "", "&eUseful to know:&r", "- &bJEI&r (right side of your inventory) shows every recipe. Type &a@rpg&r to see all class/RPG items.", "- &bXaero's World Map&r opens with &aM&r. FTB Chunks lets you claim land from the map.", "- Hold the &bUltimine&r key (default &a`&r) while mining to mine whole veins.", "- Hover a Create item and hold &aW&r to watch its Ponder tutorial."]
	"quest.49814E8944EDFB47.title": "Welcome"
	"quest.526C8CF16A0F80B2.quest_desc": ["The Gateway of the Sunlit Ascent. Lives are shared between everyone fighting."]
	"quest.526C8CF16A0F80B2.title": "World Tier: Ascent"
	"quest.532780D9DB293403.quest_desc": ["Needed for Create's more advanced machines."]
	"quest.532780D9DB293403.title": "Precision Mechanism"
	"quest.55DF3D7332FFA9FE.quest_desc": ["Open the &bSkill Tree&r screen (see Controls). Class skills grant stats and spells.", "Weapon skill branches only apply while holding that weapon type (daggers, glaives, claymores...)."]
	"quest.55DF3D7332FFA9FE.title": "Skill Trees"
	"quest.584AFC1BAC6B7B32.quest_desc": ["Build a Tier 1 rocket at a NASA Workbench, fuel it, place it on a launch pad and launch.", "You need a space suit: there's no air."]
	"quest.584AFC1BAC6B7B32.title": "The Moon"
	"quest.5B5C845071F248DF.quest_desc": ["Claim this for every mod's guide book in one go, instead of hunting for them in JEI:", "Immersive Engineering, AE2, Industrial Foregoing, RFTools, XNet, Ad Astra, the Aether,", "Eternal Starlight, Mama's Herbs and Harvest, Legendary Monsters, Apotheosis, Iron's Spells,", "Goety (two books), Weavers Paradise and Ars Nouveau.", "Create has no book: hover an item and hold &aW&r for its Ponder tutorial."]
	"quest.5B5C845071F248DF.title": "Guide Books"
	"quest.5CF2E0EC2A1FB7C9.quest_desc": ["When you die, your items (including accessories and backpack) go into a &bgravestone&r", "where you died. Open it to get everything back."]
	"quest.5CF2E0EC2A1FB7C9.title": "Gravestones"
	"quest.6016E755EB24E4DB.quest_desc": ["In the Fire Swamp."]
	"quest.6016E755EB24E4DB.title": "The Hydra"
	"quest.647592D5ECBD0C3E.quest_desc": ["At the top of the Lich Tower."]
	"quest.647592D5ECBD0C3E.title": "The Lich"
	"quest.64A9F3D3B7F0E81E.quest_desc": ["In the &bSunken City&r in deep ocean."]
	"quest.64A9F3D3B7F0E81E.title": "The Leviathan"
	"quest.6603BFEE536AA8F1.quest_desc": ["Breaks affix gear down into rarity materials."]
	"quest.6603BFEE536AA8F1.title": "Salvaging Table"
	"quest.6737AFBCCD2C4E00.quest_desc": ["Create trains run on tracks between stations, following schedules."]
	"quest.6737AFBCCD2C4E00.title": "Trains"
	"quest.6E88A420F2FE3AF4.quest_desc": ["In the Nether's &bSoul Blacksmith&r."]
	"quest.6E88A420F2FE3AF4.title": "Netherite Monstrosity"
	"quest.6F17F38658B28EB1.quest_desc": ["Throw an &bender pearl&r at a bee nest or beehive to enter."]
	"quest.6F17F38658B28EB1.title": "The Bumblezone"
	"quest.6FA33DDAD7EC6591.quest_desc": ["Better Nether adds biomes, and fortresses are redesigned."]
	"quest.6FA33DDAD7EC6591.title": "The Nether"
	"quest.70804A514087D53B.quest_desc": ["Gliding uses stamina. Campfires and other heat sources create &bupdrafts&r that lift you."]
	"quest.70804A514087D53B.title": "Paraglider"
	"quest.713927290BBFD237.quest_desc": ["In the &bFrosted Prison&r in snowy biomes."]
	"quest.713927290BBFD237.title": "Maledictus"
	"quest.757B52BC332F4734.quest_desc": ["Build a portal frame from &bglowstone&r and pour in a water bucket.", "Deep Aether adds extra biomes."]
	"quest.757B52BC332F4734.title": "The Aether"
	"quest.77A9E017D312DF01.quest_desc": ["Grappling hooks pull you up cliffs. Climb or descend the rope with your movement keys and jump to let go.", "Higher tiers (gold, diamond, netherite) have a longer rope."]
	"quest.77A9E017D312DF01.title": "Grappling Hook"
	"quest.77AB01B5735F1F18.quest_desc": ["NPC &btrainers&r (Radical Cobblemon Trainers) spawn around the world and will challenge you."]
	"quest.77AB01B5735F1F18.title": "Trainer Battles"
	"quest.7871C7BE36619952.quest_desc": ["Boss of the Aether's bronze dungeons."]
	"quest.7871C7BE36619952.title": "The Slider"
	"quest.78975E4FB0D52F14.quest_desc": ["Makes new spell scrolls from ink and focus items."]
	"quest.78975E4FB0D52F14.title": "Scroll Forge"
	"quest.79E1C4272D089026.quest_desc": ["Poké Balls are crafted from apricorns, which grow on apricorn trees."]
	"quest.79E1C4272D089026.title": "Poké Balls"
	"quest.7C615D8268E92C37.quest_desc": ["Underground in the &bAncient Factory&r."]
	"quest.7C615D8268E92C37.title": "The Harbinger"
}
